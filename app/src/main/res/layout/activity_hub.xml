<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="32dp">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_logo"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:src="@drawable/ic_logo"
                app:tint="@color/on_accent" />

            <TextView
                style="@style/Text.Numeric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/version_chip"
                style="@style/Text.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_outline"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/theme_toggle"
                style="@style/IconButton.Boxed"
                android:contentDescription="@string/theme_to_dark"
                android:src="@drawable/ic_moon" />

            <ImageButton
                android:id="@+id/source_button"
                style="@style/IconButton.Boxed"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/view_source"
                android:src="@drawable/ic_code" />
        </LinearLayout>

        <!-- 标题 -->
        <TextView
            style="@style/Text.Mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.14"
            android:text="@string/home_eyebrow"
            android:textColor="@color/accent_ink" />

        <TextView
            android:id="@+id/home_title"
            style="@style/Text.H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/hub_title" />

        <TextView
            android:id="@+id/home_desc"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/hub_desc" />

        <!-- 六种架构 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hub_section" />

            <TextView
                style="@style/Text.Note"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/hub_section_hint" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/arch_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:divider="@android:color/transparent"
            android:orientation="vertical"
            android:showDividers="middle" />

        <!-- 对比页入口 -->
        <include
            android:id="@+id/card_compare"
            layout="@layout/item_demo_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            style="@style/Text.Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/home_footer"
            android:textColor="@color/text_dim" />
    </LinearLayout>
</ScrollView>
